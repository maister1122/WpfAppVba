<UserControl x:Class="SistemaGestion.ValidarPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource ThemeBgPrincipal}">

    <UserControl.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchInput" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBordeInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LblSeccion" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoSec}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Buscador -->
            <RowDefinition Height="*"/>      <!-- Grilla de pedidos -->
            <RowDefinition Height="Auto"/>   <!-- Cabecera del detalle -->
            <RowDefinition Height="*"/>      <!-- Grilla de ítems -->
            <RowDefinition Height="Auto"/>   <!-- Totales + botones -->
        </Grid.RowDefinitions>

        <!-- ── Buscador ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtBuscar" Grid.Column="0"
                     Style="{StaticResource SearchInput}" Margin="0,0,6,0"
                     ToolTip="Busca por código de documento, cliente/proveedor o referencia — solo se listan los pedidos que todavía no tienen factura"
                     TextChanged="TxtBuscar_TextChanged"/>
            <Button Content="Actualizar" Grid.Column="1"
                    Style="{StaticResource Btn}"
                    Background="{DynamicResource ThemeBtnSecBg}"
                    Foreground="{DynamicResource ThemeTexto}"
                    Click="BtnActualizar_Click"/>
        </Grid>

        <!-- ── Pedidos ────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True"
                BorderBrush="{DynamicResource ThemeBorde}" BorderThickness="1"
                Background="{DynamicResource ThemeBgSurface}">
            <DataGrid x:Name="GridPedidos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      FontSize="12"
                      SelectionChanged="GridPedidos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"          Binding="{Binding Linea}"       Width="40"/>
                    <DataGridTextColumn Header="Documento"  Binding="{Binding Codigo}"      Width="100"/>
                    <DataGridTextColumn Header="Fecha"      Binding="{Binding FechaStr}"    SortMemberPath="Fecha" Width="140"/>
                    <DataGridTextColumn Header="Movimiento" Binding="{Binding Movimiento}"  Width="90"/>
                    <DataGridTextColumn Header="Cliente / Proveedor"
                                        Binding="{Binding TerceroDesc}" Width="*"/>
                    <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}"  Width="140"/>
                    <DataGridTextColumn Header="Importe"
                                        Binding="{Binding Importe, StringFormat=#\,##0.00}"
                                        Width="110"
                                        ElementStyle="{StaticResource CeldaNumero}"/>
                    <DataGridTextColumn Header="Facturado"
                                        Binding="{Binding Facturado, StringFormat=#\,##0.00}"
                                        Width="110"
                                        ElementStyle="{StaticResource CeldaNumero}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Cabecera del detalle ───────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="LblDetalleHeader"
                           Text="Artículos del pedido"
                           Style="{StaticResource LblSeccion}"/>
                <TextBlock Text="— al validar, lo tildado se suma por categoría: una línea de factura por categoría"
                           FontSize="10"
                           Foreground="{DynamicResource ThemeTextoSec}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Marcar todos" Margin="0,0,6,0"
                        Style="{StaticResource Btn}"
                        Background="{DynamicResource ThemeBtnSecBg}"
                        Foreground="{DynamicResource ThemeTexto}"
                        Click="BtnMarcarTodos_Click"/>
                <Button Content="Desmarcar todos"
                        Style="{StaticResource Btn}"
                        Background="{DynamicResource ThemeBtnSecBg}"
                        Foreground="{DynamicResource ThemeTexto}"
                        Click="BtnDesmarcarTodos_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── Ítems del pedido ───────────────────────────────────────────── -->
        <Border Grid.Row="3" CornerRadius="6" ClipToBounds="True"
                BorderBrush="{DynamicResource ThemeBorde}" BorderThickness="1"
                Background="{DynamicResource ThemeBgSurface}">
            <DataGrid x:Name="GridItems"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="✓" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Seleccionado, Mode=OneWay}"
                                          Click="ChkItem_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Lín."        Binding="{Binding Linea}"       Width="45"/>
                    <DataGridTextColumn Header="Código"      Binding="{Binding Codigo}"      Width="90"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="Categoría"
                                        Binding="{Binding CategoriaDescripcion}" Width="150"/>
                    <DataGridTextColumn Header="Cantidad"
                                        Binding="{Binding Cantidad, StringFormat=#\,##0.##}"
                                        Width="90"
                                        ElementStyle="{StaticResource CeldaNumero}"/>
                    <DataGridTextColumn Header="Importe"
                                        Binding="{Binding Importe, StringFormat=#\,##0.00}"
                                        Width="110"
                                        ElementStyle="{StaticResource CeldaNumero}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Totales + acciones ─────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Seleccionado:" Style="{StaticResource LblSeccion}" Margin="0,0,6,0"/>
                <TextBlock x:Name="LblTotalSeleccionado"
                           Text="0,00"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTexto}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="LblItemsSeleccionados"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource ThemeTextoSec}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnValidar" Content="Validar pedido" Margin="0,0,6,0"
                        Background="#1A73E8" Foreground="White"
                        Style="{StaticResource Btn}" Click="BtnValidar_Click"/>
                <Button x:Name="BtnCancelar" Content="Cancelar"
                        Background="{DynamicResource ThemeBtnSecBg}"
                        Foreground="{DynamicResource ThemeBtnSecFg}"
                        Style="{StaticResource Btn}" Click="BtnCancelar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
