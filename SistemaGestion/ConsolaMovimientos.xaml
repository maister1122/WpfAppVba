<Window x:Class="SistemaGestion.ConsolaMovimientos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaGestion"
        Title="Sistema de Gestión"
        WindowState="Maximized"
        MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBgPrincipal}"
        Icon="icono.ico"
        Closing="ConsolaMovimientos_Closing">

    <Window.Resources>

        <!-- ── Ítem de navegación lateral ─────────────────────────────── -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0,12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoSec}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeNavHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeNavActivoBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón de acceso rápido (top bar) ───────────────────────── -->
        <Style x:Key="QuickBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TabControl de sub-pestañas ─────────────────────────────── -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBgContenido}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
        </Style>

        <!-- ── TabItem de sub-pestañas ────────────────────────────────── -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9AA3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="TabText"
                                       Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A6FE3"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeTabSelBg}"/>
                                <Setter TargetName="TabText"   Property="Foreground"  Value="#4A6FE3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeTabHoverBg}"/>
                                <Setter TargetName="TabText"   Property="Foreground"  Value="#4A6FE3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón "▾" de la barra de pestañas (lista completa) ─────── -->
        <Style x:Key="TabListaBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoSec}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeTabHoverBg}"/>
                                <Setter Property="Foreground" Value="#4A6FE3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Lista de pestañas del botón "▾" ─────────────────────────────
             Plantilla propia de ContextMenu/MenuItem: la de Windows trae su
             franja blanca de íconos y su fondo de sistema, que en tema oscuro
             se ven como una barra blanca. Acá todo sale de los recursos de tema. -->
        <Style x:Key="TabListaMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeBgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexto}"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="4" MaxHeight="440">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabListaItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="False"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeTabHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TabControl de la consola: una sola fila de pestañas ─────────
             Reemplaza el TabPanel por defecto (que apila las pestañas en varias
             filas cuando no entran) por un StackPanel horizontal dentro de un
             ScrollViewer: las pestañas siguen todas en una fila y, cuando no
             entran, las más antiguas (la fija y las que le siguen) quedan fuera
             de vista y se llega a ellas con el scroll horizontal. El botón "▾"
             de la derecha abre la lista completa (estilo Chrome). -->
        <Style x:Key="TabsConDesborde" TargetType="TabControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Encabezados de pestaña: una sola fila con scroll
                                 horizontal cuando no entran todas -->
                            <ScrollViewer x:Name="BarraPestanas"
                                          Grid.Row="0" Grid.Column="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          Panel.ZIndex="1"
                                          PreviewMouseWheel="BarraPestanas_PreviewMouseWheel">
                                <ItemsPresenter x:Name="HeaderPanel"
                                                Margin="2,2,0,0"
                                                KeyboardNavigation.TabIndex="1"/>
                            </ScrollViewer>

                            <!-- Lista completa de pestañas (incluidas las que quedaron fuera de vista) -->
                            <Button x:Name="BtnPestanasTodas"
                                    Grid.Row="0" Grid.Column="1"
                                    Content="▾" Width="26"
                                    Margin="4,2,6,2"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource TabListaBtn}"
                                    ToolTip="Ver todas las pestañas"
                                    Click="BtnPestanasTodas_Click"/>

                            <Border x:Name="ContentPanel"
                                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Encabezado de sección en la barra lateral ──────────────── -->
        <Style x:Key="NavSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoMuted}"/>
            <Setter Property="Margin" Value="14,10,0,4"/>
        </Style>

    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Top bar -->
            <RowDefinition Height="*"/>    <!-- Sidebar + Contenido -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- TOP BAR                                                      -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgTopBar}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="#4A6FE3" Margin="0,0,10,0">
                        <TextBlock Text="SG" FontSize="13" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Sistema de Gestión"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeTexto}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Accesos rápidos + Usuario -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnQuick_Venta" Content="🛒  Venta"
                            Style="{StaticResource QuickBtn}" Background="#E53935"
                            Click="BtnQuick_Venta_Click"/>
                    <Button x:Name="BtnQuick_Compra" Content="📥  Compra"
                            Style="{StaticResource QuickBtn}" Background="#1E88E5"
                            Click="BtnQuick_Compra_Click"/>
                    <Button x:Name="BtnQuick_Salida" Content="📤  Salida"
                            Style="{StaticResource QuickBtn}" Background="#FB8C00"
                            Click="BtnQuick_Salida_Click"/>
                    <Button x:Name="BtnQuick_Entrada" Content="📦  Entrada"
                            Style="{StaticResource QuickBtn}" Background="#43A047"
                            Click="BtnQuick_Entrada_Click"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <TextBlock x:Name="LblUsuario"
                               FontSize="11" Foreground="{DynamicResource ThemeTextoSec}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <TextBlock x:Name="LblSucursal"
                               FontSize="11" Foreground="{DynamicResource ThemeTextoSec}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <TextBlock x:Name="LblEmpresa"
                               FontSize="11" Foreground="{DynamicResource ThemeTextoSec}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <!-- ── Actualización de la app (manual / opt-in) ──────────── -->
                    <!-- Oculto mientras no haya versión nueva. 3 estados visuales. -->
                    <Border x:Name="BloqueActualizar" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Estado A: hay versión nueva (el usuario decide) -->
                            <Button x:Name="BtnActualizar" Visibility="Collapsed"
                                    Content="🔄  Actualizar"
                                    Style="{StaticResource QuickBtn}" Background="#6C4AE3"
                                    ToolTip="Hay una nueva versión disponible"
                                    Click="BtnActualizar_Click"/>

                            <!-- Estado B: descargando en segundo plano -->
                            <StackPanel x:Name="PanelDescarga" Orientation="Horizontal"
                                        Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="LblDescarga" Text="Descargando…"
                                           FontSize="11" Foreground="#9AA3B8"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ProgressBar x:Name="BarraDescarga" Width="120" Height="8"
                                             Minimum="0" Maximum="100" Value="0"
                                             Background="#1A1E2E" Foreground="#6C4AE3"
                                             BorderThickness="0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Estado C: lista para reiniciar (el usuario decide cuándo) -->
                            <Button x:Name="BtnReiniciar" Visibility="Collapsed"
                                    Content="✅  Reiniciar para actualizar"
                                    Style="{StaticResource QuickBtn}" Background="#2E7D32"
                                    ToolTip="La actualización está lista"
                                    Click="BtnReiniciar_Click"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <Button x:Name="BtnTema" Content="🌙"
                            Width="36" Height="30" FontSize="13"
                            Background="{DynamicResource ThemeBtnSecBg}"
                            Foreground="{DynamicResource ThemeBtnSecFg}"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Cambiar tema claro / oscuro"
                            Click="BtnTema_Click"/>

                    <!-- Estado de conexión -->
                    <Border x:Name="PillConexion"
                            VerticalAlignment="Center"
                            CornerRadius="10" Padding="12,4" Background="#2E7D32">
                        <TextBlock x:Name="LblConexion" Text="●  En línea"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR + CONTENIDO                                         -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── BARRA LATERAL ──────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Ítems de navegación -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="0,8,0,8">
                            
                            <Button x:Name="BtnNav_Dashboard"
                                    Content="📊  Dashboard"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Dashboard_Click"/>
                            <Button x:Name="BtnNav_Articulos"
                                    Content="📋  Artículos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Articulos_Click"/>
                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorde}" Margin="12,8"/>
                            <!-- Nivel pedidos -->
                            <TextBlock Text="PEDIDOS" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Ventas"
                                    Content="🛒  Ventas"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Ventas_Click"/>
                            <Button x:Name="BtnNav_Compras"
                                    Content="📥  Compras"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Compras_Click"/>
                            <!-- Nivel traspasos -->
                            <TextBlock Text="TRASPASOS" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Entradas"
                                    Content="📦  Entradas"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Entradas_Click"/>
                            <Button x:Name="BtnNav_Salidas"
                                    Content="📤  Salidas"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Salidas_Click"/>
                            <!-- Nivel correciones -->
                            <TextBlock Text="CORRECCIONES" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Repuestas"
                                    Content="🔧  Ingresos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Repuestas_Click"/>
                            <Button x:Name="BtnNav_Retirados"
                                    Content="🔧  Egresos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Retirados_Click"/>

                            <!-- Nivel facturas -->
                            <TextBlock Text="FACTURAS" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Ingresos"
                                    Content="🧾  Ingresos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Ingresos_Click"/>
                            <Button x:Name="BtnNav_Egresos"
                                    Content="🧾  Egresos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Egresos_Click"/>
                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorde}" Margin="12,8"/>
                            
                            <Button x:Name="BtnNav_Movimientos"
                                    Content="📈  Movimientos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Movimientos_Click"/>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorde}" Margin="12,8"/>

                            <Button x:Name="BtnNav_Terceros"
                                    Content="👥  Terceros"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Terceros_Click"/>
                            <Button x:Name="BtnNav_Familias"
                                    Content="🗂  Familias"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Familias_Click"/>
                            <Button x:Name="BtnNav_Productos"
                                    Content="📦  Productos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Productos_Click"/>
                            <Button x:Name="BtnNav_Industrias"
                                    Content="🏭  Industrias"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Industrias_Click"/>
                            <Button x:Name="BtnNav_Categorias"
                                    Content="🏷  Categorías"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Categorias_Click"/>
                            <Button x:Name="BtnNav_Inventarios"
                                    Content="📊  Inventarios"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Inventarios_Click"/>
                            <Button x:Name="BtnNav_Configuracion"
                                    Content="⚙  Configuración"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Configuracion_Click"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cerrar sesión (fijo al fondo) -->
                    <Border Grid.Row="1"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ThemeBorde}">
                        <Button Content="⏻  Cerrar Sesión"
                                Style="{StaticResource NavBtn}"
                                Foreground="#EF5350"
                                Click="BtnCerrarSesion_Click"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── ÁREA DE CONTENIDO ──────────────────── -->
            <TabControl x:Name="TabContenido" Grid.Column="1"
                        Style="{StaticResource TabsConDesborde}"
                        Background="{DynamicResource ThemeBgContenido}"
                        BorderThickness="0" Padding="0">
                <!-- Pestaña fija: título y contenido cambian según el menú lateral -->
                <TabItem x:Name="TabFijo">
                    <TabItem.Header>
                        <TextBlock x:Name="TabFijoTitulo" Text="Artículos"
                                   VerticalAlignment="Center"/>
                    </TabItem.Header>
                    <ContentControl x:Name="TabFijoContenido"/>
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>

</Window>
