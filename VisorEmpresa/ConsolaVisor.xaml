<Window x:Class="SistemaGestion.ConsolaMovimientos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor Empresa"
        WindowState="Maximized"
        MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBgPrincipal}"
        Closing="ConsolaVisor_Closing">

    <!-- NOTA: esta es la consola PROPIA del visor, pero declara la clase
         SistemaGestion.ConsolaMovimientos a propósito: los formularios vinculados de la
         app principal (PreciosGeneral, SucursalesGeneral, etc.) abren sus pestañas
         haciendo `Window.GetWindow(this) as ConsolaMovimientos` — al compilar esta
         clase (y NO vincular la consola original) dentro del ensamblado del visor,
         esos formularios funcionan sin tocar una línea de la app principal. -->

    <Window.Resources>

        <!-- ── Ítem de navegación lateral (mismo estilo que la app principal) ── -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0,12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoSec}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeNavHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeNavActivoBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Encabezado de sección en la barra lateral ──────────────── -->
        <Style x:Key="NavSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoMuted}"/>
            <Setter Property="Margin" Value="14,10,0,4"/>
        </Style>

        <!-- ── Botón "▾" de la barra de pestañas (lista completa) ─────── -->
        <Style x:Key="TabListaBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextoSec}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeTabHoverBg}"/>
                                <Setter Property="Foreground" Value="#4A6FE3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Lista de pestañas del botón "▾" ─────────────────────────────
             Plantilla propia de ContextMenu/MenuItem: la de Windows trae su
             franja blanca de íconos y su fondo de sistema, que en tema oscuro
             se ven como una barra blanca. Acá todo sale de los recursos de tema. -->
        <Style x:Key="TabListaMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeBgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexto}"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="4" MaxHeight="440">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabListaItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="False"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="{DynamicResource ThemeTabHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TabControl de la consola: una sola fila de pestañas ─────────
             Reemplaza el TabPanel por defecto (que apila las pestañas en varias
             filas cuando no entran) por un StackPanel horizontal dentro de un
             ScrollViewer: las pestañas siguen todas en una fila y, cuando no
             entran, las más antiguas (la fija y las que le siguen) quedan fuera
             de vista y se llega a ellas con el scroll horizontal. El botón "▾"
             de la derecha abre la lista completa (estilo Chrome). -->
        <Style x:Key="TabsConDesborde" TargetType="TabControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Encabezados de pestaña: una sola fila con scroll
                                 horizontal cuando no entran todas -->
                            <ScrollViewer x:Name="BarraPestanas"
                                          Grid.Row="0" Grid.Column="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          Panel.ZIndex="1"
                                          PreviewMouseWheel="BarraPestanas_PreviewMouseWheel">
                                <ItemsPresenter x:Name="HeaderPanel"
                                                Margin="2,2,0,0"
                                                KeyboardNavigation.TabIndex="1"/>
                            </ScrollViewer>

                            <!-- Lista completa de pestañas (incluidas las que quedaron fuera de vista) -->
                            <Button x:Name="BtnPestanasTodas"
                                    Grid.Row="0" Grid.Column="1"
                                    Content="▾" Width="26"
                                    Margin="4,2,6,2"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource TabListaBtn}"
                                    ToolTip="Ver todas las pestañas"
                                    Click="BtnPestanasTodas_Click"/>

                            <Border x:Name="ContentPanel"
                                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Top bar -->
            <RowDefinition Height="*"/>    <!-- Sidebar + Contenido -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- TOP BAR                                                      -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgTopBar}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="#1A3A6B" Margin="0,0,10,0">
                        <TextBlock Text="VE" FontSize="13" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Visor Empresa"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTexto}"/>
                        <TextBlock Text="Todas las sucursales de la empresa"
                                   FontSize="10" Foreground="{DynamicResource ThemeTextoSec}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filtros globales / usuario / empresa / tema / conexión -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Herramientas de administración (mismas de Configuración en la
                         app principal): toda cuenta que entra al visor ya es admin,
                         así que se muestran siempre, sin gating adicional. -->
                    <Button x:Name="BtnRegenerarCodigos" Content="🔢 Regenerar códigos"
                            Height="30" FontSize="11" FontWeight="SemiBold" Padding="10,0"
                            Background="#6A1B9A" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="BtnRegenerarCodigos_Click"/>
                    <Button x:Name="BtnRecalcularPrecios" Content="💲 Recalcular precios"
                            Height="30" FontSize="11" FontWeight="SemiBold" Padding="10,0"
                            Background="#EF6C00" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="BtnRecalcularPrecios_Click"/>
                    <Button x:Name="BtnSincronizarAppsheets" Content="🧾 Sincronizar AppSheets"
                            Height="30" FontSize="11" FontWeight="SemiBold" Padding="10,0"
                            Background="#2E7D32" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="BtnSincronizarAppsheets_Click"/>
                    <Button x:Name="BtnPurgarOcultos" Content="🗑️ Eliminar ocultos"
                            Height="30" FontSize="11" FontWeight="SemiBold" Padding="10,0"
                            Background="#B71C1C" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,14,0"
                            Click="BtnPurgarOcultos_Click"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="0,0,14,0"/>

                    <!-- Empresa y Año: filtros GLOBALES — el dashboard y las vistas
                         de documentos cargan según estos dos combos. -->
                    <TextBlock Text="Empresa:" FontSize="11"
                               Foreground="{DynamicResource ThemeTextoSec}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbEmpresaTop" Width="100" Height="30"
                              VerticalAlignment="Center"
                              SelectionChanged="CmbEmpresaTop_SelectionChanged"/>

                    <TextBlock Text="Año:" FontSize="11"
                               Foreground="{DynamicResource ThemeTextoSec}"
                               VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="CmbAnioTop" Width="80" Height="30"
                              VerticalAlignment="Center"
                              SelectionChanged="CmbAnioTop_SelectionChanged"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <TextBlock x:Name="LblUsuario"
                               FontSize="11" Foreground="{DynamicResource ThemeTextoSec}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <!-- ── Actualización de la app (manual / opt-in) ──────────── -->
                    <!-- Oculto mientras no haya versión nueva. 3 estados visuales. -->
                    <Border x:Name="BloqueActualizar" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Estado A: hay versión nueva (el usuario decide) -->
                            <Button x:Name="BtnActualizar" Visibility="Collapsed"
                                    Content="🔄  Actualizar"
                                    Height="30" FontSize="11" FontWeight="SemiBold" Padding="10,0"
                                    Background="#6C4AE3" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    ToolTip="Hay una nueva versión disponible"
                                    Click="BtnActualizar_Click"/>

                            <!-- Estado B: descargando en segundo plano -->
                            <StackPanel x:Name="PanelDescarga" Orientation="Horizontal"
                                        Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="LblDescarga" Text="Descargando…"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextoSec}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ProgressBar x:Name="BarraDescarga" Width="120" Height="8"
                                             Minimum="0" Maximum="100" Value="0"
                                             Background="{DynamicResource ThemeInputBg}" Foreground="#6C4AE3"
                                             BorderThickness="0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Estado C: lista para reiniciar (el usuario decide cuándo) -->
                            <Button x:Name="BtnReiniciar" Visibility="Collapsed"
                                    Content="✅  Reiniciar para actualizar"
                                    Height="30" FontSize="11" FontWeight="SemiBold" Padding="10,0"
                                    Background="#2E7D32" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    ToolTip="La actualización está lista"
                                    Click="BtnReiniciar_Click"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorde}" Margin="10,0"/>

                    <Button x:Name="BtnTema" Content="🌙"
                            Width="36" Height="30" FontSize="13"
                            Background="{DynamicResource ThemeBtnSecBg}"
                            Foreground="{DynamicResource ThemeBtnSecFg}"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Cambiar tema claro / oscuro"
                            Click="BtnTema_Click"/>

                    <!-- Estado de conexión -->
                    <Border x:Name="PillConexion"
                            VerticalAlignment="Center"
                            CornerRadius="10" Padding="12,4" Background="#2E7D32">
                        <TextBlock x:Name="LblConexion" Text="●  En línea"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR + CONTENIDO                                         -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── BARRA LATERAL ──────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Ítems de navegación -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="0,8,0,8">
                            <!-- Nivel empresa: catálogos propios de la empresa seleccionada -->
                            <TextBlock Text="NIVEL EMPRESA" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Dashboard"
                                    Content="📊  Dashboard"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Dashboard_Click"/>
                            <Button x:Name="BtnNav_Articulos"
                                    Content="📋  Artículos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Articulos_Click"/>
                            <Button x:Name="BtnNav_Familias"
                                    Content="🗂  Familias"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Familias_Click"/>
                            <Button x:Name="BtnNav_Productos"
                                    Content="📦  Productos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Productos_Click"/>
                            <Button x:Name="BtnNav_Industrias"
                                    Content="🏭  Industrias"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Industrias_Click"/>
                            <Button x:Name="BtnNav_Categorias"
                                    Content="🏷  Categorías"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Categorias_Click"/>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorde}" Margin="12,8"/>

                            <!-- Documentos: solo visualización (sin filtro por sucursal).
                                 Mismas secciones que SistemaGestión. -->
                            <TextBlock Text="PEDIDOS" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Ventas"
                                    Content="🛒  Ventas"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Ventas_Click"/>
                            <Button x:Name="BtnNav_Compras"
                                    Content="📥  Compras"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Compras_Click"/>

                            <TextBlock Text="TRASPASOS" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Traspasos"
                                    Content="🔄  Traspasos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Traspasos_Click"/>

                            <TextBlock Text="CORRECCIONES" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Repuestas"
                                    Content="🔧  Ingresos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Repuestas_Click"/>
                            <Button x:Name="BtnNav_Retirados"
                                    Content="🔧  Egresos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Retirados_Click"/>

                            <TextBlock Text="FACTURAS" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Ingresos"
                                    Content="🧾  Créditos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Ingresos_Click"/>
                            <Button x:Name="BtnNav_Egresos"
                                    Content="🧾  Débitos"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Egresos_Click"/>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorde}" Margin="12,8"/>

                            
                            <Button x:Name="BtnNav_Precios"
                                    Content="💲  Precios"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Precios_Click"/>
                            <Button x:Name="BtnNav_Sucursales"
                                    Content="🏪  Sucursales"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Sucursales_Click"/>
                            <Button x:Name="BtnNav_Regiones"
                                    Content="🌐  Regiones"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Regiones_Click"/>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorde}" Margin="12,8"/>

                            <!-- Superiores: administración por encima de una empresa puntual -->
                            <TextBlock Text="SUPERIORES" Style="{StaticResource NavSeccion}"/>
                            <Button x:Name="BtnNav_Empresas"
                                    Content="🏢  Empresas"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Empresas_Click"/>
                            <Button x:Name="BtnNav_Usuarios"
                                    Content="👤  Usuarios"
                                    Style="{StaticResource NavBtn}"
                                    Click="BtnNav_Usuarios_Click"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cerrar sesión (fijo al fondo) -->
                    <Border Grid.Row="1"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ThemeBorde}">
                        <Button Content="⏻  Cerrar Sesión"
                                Style="{StaticResource NavBtn}"
                                Foreground="#EF5350"
                                Click="BtnCerrarSesion_Click"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── ÁREA DE CONTENIDO ──────────────────── -->
            <TabControl x:Name="TabContenido" Grid.Column="1"
                        Style="{StaticResource TabsConDesborde}"
                        Background="{DynamicResource ThemeBgContenido}"
                        BorderThickness="0" Padding="0">
                <!-- Pestaña fija: título y contenido cambian según el menú lateral -->
                <TabItem x:Name="TabFijo">
                    <TabItem.Header>
                        <TextBlock x:Name="TabFijoTitulo" Text="Dashboard"
                                   VerticalAlignment="Center"/>
                    </TabItem.Header>
                    <ContentControl x:Name="TabFijoContenido"/>
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>

</Window>
